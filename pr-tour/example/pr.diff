diff --git a/src/refunds/refund.service.ts b/src/refunds/refund.service.ts
index 3a1f0c2..8d4e7b1 100644
--- a/src/refunds/refund.service.ts
+++ b/src/refunds/refund.service.ts
@@ -18,21 +18,33 @@ export class RefundService {
   async refund(paymentId: string, amount: number): Promise<Refund> {
-    const payment = await this.payments.findOneOrFail(paymentId);
-    if (amount > payment.capturedAmount) {
-      throw new RefundTooLargeError(paymentId);
-    }
-    const refund = await this.refunds.insert({ paymentId, amount });
-    await this.gateway.refund(payment.gatewayId, amount);
-    return refund;
+    return this.db.transaction(async (tx) => {
+      // Lock the payment row so two refunds can't both pass the check.
+      const payment = await tx.payments.findOneOrFail(paymentId, {
+        lock: 'FOR UPDATE',
+      });
+      const alreadyRefunded = await tx.refunds.sum('amount', {
+        paymentId,
+        status: Not('failed'),
+      });
+      if (alreadyRefunded + amount > payment.capturedAmount) {
+        throw new RefundExceedsCaptureError(paymentId, {
+          captured: payment.capturedAmount,
+          refunded: alreadyRefunded,
+        });
+      }
+      const refund = await tx.refunds.insert({ paymentId, amount });
+      await this.gateway.refund(payment.gatewayId, amount, {
+        idempotencyKey: refund.id,
+      });
+      return refund;
+    });
   }
 }
